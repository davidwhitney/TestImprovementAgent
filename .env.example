# Copy to .env (or pass --env-file). Command-line flags override these; real environment variables
# override this file. Every --option maps to COVERAGE_HARNESS_<OPTION_IN_CAPS>.

COVERAGE_HARNESS_SRC=/abs/path/to/repos/*
COVERAGE_HARNESS_TARGET=100
COVERAGE_HARNESS_AGENT=claude
# COVERAGE_HARNESS_MODEL=sonnet
COVERAGE_HARNESS_MUTATION_TARGET=80
# COVERAGE_HARNESS_SKIP_MUTATION=false
# COVERAGE_HARNESS_MANIFEST=/abs/path/to/coverage-harness.manifest.json
# COVERAGE_HARNESS_PROMPTS=/abs/path/to/prompt-overrides
# COVERAGE_HARNESS_BRANCH=coverage-harness
# COVERAGE_HARNESS_CONCURRENCY=1
# COVERAGE_HARNESS_RETRY=false
# COVERAGE_HARNESS_MAX_ITERATIONS=40
# COVERAGE_HARNESS_MAX_MUTATION_ITERATIONS=20
# COVERAGE_HARNESS_STALL_LIMIT=3
# COVERAGE_HARNESS_FIX_ATTEMPTS=3
# COVERAGE_HARNESS_AGENT_TIMEOUT=90
# COVERAGE_HARNESS_AGENT_IDLE_TIMEOUT=20
# COVERAGE_HARNESS_TEST_TIMEOUT=30
# COVERAGE_HARNESS_STRYKER_TIMEOUT=240
# COVERAGE_HARNESS_HEARTBEAT=5
# COVERAGE_HARNESS_VERBOSE=false

# Anything else here is passed through to the agent CLIs, e.g.:
# ANTHROPIC_API_KEY=
# GH_TOKEN=
# OPENROUTER_API_KEY=
